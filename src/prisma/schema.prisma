// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
// when you change this file, run `pnpx prisma format` to format it, and `pnpx prisma generate` to regenerate the Prisma Client
// update database with `pnpx prisma db push` or `pnpx prisma migrate dev`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Enum ===
enum UserRole {
  ADMIN
  USER
}


enum Gender {
  MALE // ♂️ Male
  FEMALE // ♀️ Female
  OTHER // ⚧ Other / Prefer not to say
}

enum MovieType {
  MOVIE // 🎬 Movie
  SERIES // 📺 Series
}

enum MovieStatus {
  COMMING_SOON // ⏳ Coming soon
  ONGOING // ▶️ Ongoing
  COMPLETED // ✅ Completed
  CANCELLED // ❌ Cancelled
}

enum RolePeople {
  DIRECTOR // 🎥 Director
  ACTOR // 🎭 Actor
}

enum CompanyType {
  NETWORK // 📡 TV Network
  PRODUCER // 🎞️ Production Company
}

enum VersionType {
  SUBTITLED // 🔤 Có phụ đề 
  DUBBED // 🎙️ Lồng tiếng 
  VOICE_OVER // 🗣️ Thuyết minh 
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum Provider {
  GOOGLE
  CREDENTIALS
}

// === Models ===
model User {
  id        String  @id @default(uuid()) // 🔑 Primary key (tự tăng)
  email     String?  @unique @db.VarChar(255) // 📧 Email đăng nhập
  username  String?  @unique @db.VarChar(50) // 👤 Tên hiển thị (duy nhất)
  nickname  String @db.VarChar(50) // 👤 Nickname (tùy chọn)
  gender    Gender  @default(OTHER) // ⚧ Giới tính
  avatarUrl String? @map("avatar_url") @db.VarChar(500) // 🖼️ Ảnh đại diện
  role      UserRole @default(USER) // 📝 Vai trò của user

  createdAt DateTime @default(now()) @map("created_at") // 🗓️ Thời điểm tạo
  updatedAt DateTime @updatedAt @map("updated_at") // 🔁 Tự động cập nhật khi thay đổi

  // Relations
  AuthProvider  AuthProvider[]
  Rating        Rating[]
  Favorite      Favorite[]
  WatchProgress WatchProgress[]
  Comment       Comment[]
  CommentLike   CommentLike[]
}

model AuthProvider {
  id     String @id @default(uuid()) // 🔑 Primary key (tự tăng)
  userId String @unique @map("user_id")

  provider       Provider // Tên: "google", "facebook", hoặc "credentials" (cho email/pass)
  providerUserId String?   @map("provider_user_id") // ID của user TỪ Google/Facebook

  // Mật khẩu (chỉ dùng cho provider "credentials")
  passwordHash String? @map("password_hash") @db.VarChar(255) // 🔐 Chỉ có giá trị khi là đăng ký 'credentials'

  // Bạn cũng có thể lưu token ở đây nếu cần
  refreshToken String?

  createdAt DateTime @default(now()) // 🗓️ Thời điểm tạo
  updatedAt DateTime @updatedAt // 🔁 Tự động cập nhật khi thay đổi

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // Liên kết về User

  @@unique([provider, providerUserId]) // Đảm bảo tính duy nhất: 1 user chỉ có 1 tài khoản Google
}

model Movie {
  id             String      @id @default(uuid()) // 🔑 Primary key
  publicId       String      @unique @map("public_id") @db.VarChar(255) // 🔑 Public ID
  title          String      @db.VarChar(500) // 🎬 Movie title (localized)
  originalTitle  String?     @map("original_title") @db.VarChar(500) // 🌍 Original language title
  slug           String      @unique @db.VarChar(300) // 🔗 SEO-friendly URL identifier
  description    String?     @db.Text // 📝 Movie description
  type           MovieType // 📌 Movie or series
  duration       Int? // ⏱️ Duration in minutes
  status         MovieStatus @default(COMMING_SOON) // 📋 Current release status
  imdbRating     Decimal?    @map("imdb_rating") @db.Decimal(3, 1) // ⭐ IMDb rating
  subtitledCount Int?        @map("subtitled_count") // Total episodes with subtitles
  dubbedCount    Int?        @map("dubbed_count") // Total episodes with dubbed audio
  voiceoverCount Int?        @map("voiceover_count") // Total episodes with voice-over
  franchiseId    String? // Franchise ID chuỗi phim
  partNumber     Int?
  createdAt      DateTime    @default(now()) @map("created_at") // 🗓️ Record creation time
  updatedAt      DateTime    @updatedAt @map("updated_at") // 🗓️ Record last update time

  // Relations
  images        MovieImage[]
  genres        MovieGenre[]
  topics        MovieTopic[]
  episodes      Episode[]
  seasons       Season[]
  franchise     Franchise?      @relation(fields: [franchiseId], references: [id])
  companies     MovieCompany[]
  peoples       MoviePeople[]
  Rating        Rating[]
  Favorite      Favorite[]
  WatchProgress WatchProgress[]
  Comment       Comment[]
}

model Episode {
  id            String      @id @default(uuid())
  movieId       String
  seasonId      String
  versionType   VersionType @default(SUBTITLED)
  episodeNumber Int
  title         String      @db.VarChar(255)
  description   String      @db.Text
  duration      Int?
  releaseDate   DateTime    @map("release_date")
  videoUrl      String?     @map("video_url") @db.VarChar(500)
  trailerUrl    String?     @map("trailer_url") @db.VarChar(500)
  status        MovieStatus @default(COMMING_SOON)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  movie           Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  season          Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchProgresses WatchProgress[]
}

model Season {
  id           String   @id @default(uuid())
  movieId      String
  seasonNumber Int
  title        String   @db.VarChar(255)
  description  String   @db.Text
  episodeCount Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  movie    Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodes Episode[]
}

model Franchise {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  movies Movie[]
}

model MovieImage {
  id        String   @id @default(uuid())
  movieId   String
  path      String   @db.VarChar(500)
  type      String   @db.VarChar(50)
  format    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model MovieGenre {
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   String
  genre     Genre    @relation(fields: [genreId], references: [id])
  genreId   String
  createdAt DateTime @default(now())

  @@id([movieId, genreId])
}

model Genre {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())

  // Relations
  movies MovieGenre[]
}

model Topic {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(255)
  description String   @db.Text
  slug        String   @unique @db.VarChar(255)
  createdAt   DateTime @default(now())

  // Relations
  movies MovieTopic[]
}

model MovieTopic {
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id])
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id])
  createdAt DateTime @default(now())

  @@id([movieId, topicId])
}

model Company {
  id        String      @id @default(uuid())
  name      String      @db.VarChar(255)
  type      CompanyType
  country   String      @db.VarChar(255)
  slug      String      @unique @db.VarChar(255)
  createdAt DateTime    @default(now())

  // Relations
  movies MovieCompany[]
}

model MovieCompany {
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@id([movieId, companyId])
}

model People {
  id           String    @id @default(uuid())
  publicId     String    @unique @map("public_id") @db.VarChar(255)
  originalName String    @db.VarChar(255)
  birthDate    DateTime? @map("birth_date")
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  nationality  String?   @db.VarChar(255)
  biography    String?   @db.Text
  gender       Gender?
  slug         String    @unique @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  movies MoviePeople[]
}

model MoviePeople {
  movieId   String
  movie     Movie      @relation(fields: [movieId], references: [id])
  peopleId  String
  people    People     @relation(fields: [peopleId], references: [id])
  role      RolePeople
  createdAt DateTime   @default(now())

  @@id([movieId, peopleId])
}

model Rating {
  id         String   @id @default(uuid())
  userId     String
  movieId    String
  rating     Int
  review     String?  @db.Text
  isSpoiler  Boolean  @default(false)
  likesCount Int      @default(0) @map("likes_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user  User  @relation(fields: [userId], references: [id])
  movie Movie @relation(fields: [movieId], references: [id])
}

model Comment {
  id        String  @id @default(uuid())
  userId    String
  movieId   String
  eposideId String
  parentId  String?

  content       String   @db.Text
  likesCount    Int      @default(0) @map("likes_count")
  dislikesCount Int      @default(0) @map("dislikes_count")
  isSpoiler     Boolean  @default(false) @map("is_spoiler")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id])
  movie        Movie         @relation(fields: [movieId], references: [id])
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies      Comment[]     @relation("CommentReplies")
  commentLikes CommentLike[]
}

model CommentLike {
  id        String       @id @default(uuid())
  userId    String
  commentId String
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  comment Comment @relation(fields: [commentId], references: [id])

  @@unique([userId, commentId]) // mỗi người chỉ được like 1 lần 1 bình luận
}

model WatchProgress {
  id          String  @id @default(uuid())
  userId      String
  movieId     String
  episodeId   String
  currentTime Int     @map("current_time") // thời gian xem (giây)
  isCompleted Boolean @default(false) @map("is_completed")

  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User     @relation(fields: [userId], references: [id])
  movie   Movie?   @relation(fields: [movieId], references: [id])
  episode Episode? @relation(fields: [episodeId], references: [id])

  @@unique([userId, movieId, episodeId])
}
